<div class="page-header">
  <h2>タスク一覧</h2>
  <%= link_to "＋ 新規タスク作成", new_task_path, class: "btn btn-primary" %>
</div>

<% if @tasks.any? %>
  <table class="task-table">
    <thead>
      <tr>
        <th>タイトル</th>
        <th>期限</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= link_to task.title, task, class: "task-title-link" %></td>
          <td><%= task.due_date %></td>
          <td class="table-actions">
            <%= link_to "詳細", task, class: "btn btn-sm btn-secondary" %>
            <%= link_to "編集", edit_task_path(task), class: "btn btn-sm btn-warning" %>
            <%= link_to "削除", task, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-message">登録されているタスクはまだありません。「＋ 新規タスク作成」から追加してください。</p>
<% end %>