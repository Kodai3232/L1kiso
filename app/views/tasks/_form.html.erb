<%= form_with(model: task) do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, "詳細内容" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :due_date, "期限" %>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>